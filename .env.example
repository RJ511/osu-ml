# Cria uma aplicação OAuth em https://osu.ppy.sh/home/account/edit#new-oauth-application
# (o Callback URL pode ficar vazio: usamos Client Credentials).
OSU_CLIENT_ID=
OSU_CLIENT_SECRET=

# Identifica a aplicação perante a API (boa prática). Inclui um contacto.
OSUML_USER_AGENT=osuml/0.1 (+https://github.com/<teu-user>/osu-ml)

# SQLite por omissão. Para PostgreSQL:
# OSUML_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/osuml
OSUML_DATABASE_URL=sqlite:///data/osuml.db
OSUML_DATA_DIR=data

# Intervalo mínimo entre pedidos (segundos). A política pede <= 60/min.
OSUML_MIN_INTERVAL_OSU=1.1

# Snapshot de best/firsts/pinned só é refeito depois deste número de horas.
OSUML_SNAPSHOT_TTL_HOURS=168
# Utilizador (username -> id) só é re-resolvido depois deste número de horas.
OSUML_USER_TTL_HOURS=24
